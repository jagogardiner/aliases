#!/bin/bash

alias home='cd ~/'
alias logg='git log --pretty=short'
alias cls='clear'
alias add.='git add .'
alias cond='git cherry-pick --continue'
alias pick='git cherry-pick';
alias commit='git commit'
alias zsrc='source ~/.zshrc'

function chout() {
	git checkout $1 -- $2
}

function search()
{
	grep -rni $1
}
